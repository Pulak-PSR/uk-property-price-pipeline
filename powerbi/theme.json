{
  "name": "UK Property Clean",
  "dataColors": ["#1F4E79", "#2E86AB", "#F18F01", "#6A994E", "#BC4B51", "#8E7DBE", "#5B6770", "#C9A227"],
  "background": "#FFFFFF",
  "foreground": "#1F2933",
  "tableAccent": "#1F4E79",
  "good": "#2E7D32",
  "neutral": "#F18F01",
  "bad": "#C62828",
  "maximum": "#1F4E79",
  "center": "#F1F5F9",
  "minimum": "#BFD7EA",
  "textClasses": {
    "label": { "fontFace": "Segoe UI", "fontSize": 10, "color": "#52606D" },
    "callout": { "fontFace": "Segoe UI Semibold", "fontSize": 28, "color": "#1F4E79" },
    "title": { "fontFace": "Segoe UI Semibold", "fontSize": 14, "color": "#1F2933" },
    "header": { "fontFace": "Segoe UI Semibold", "fontSize": 12, "color": "#1F2933" }
  },
  "visualStyles": {
    "*": {
      "*": {
        "title": [{ "show": true, "fontColor": { "solid": { "color": "#1F2933" } }, "fontSize": 12, "fontFamily": "Segoe UI Semibold" }],
        "background": [{ "show": true, "color": { "solid": { "color": "#FFFFFF" } }, "transparency": 0 }],
        "border": [{ "show": true, "color": { "solid": { "color": "#E4E7EB" } }, "radius": 6 }],
        "visualHeader": [{ "show": false }]
      }
    },
    "page": {
      "*": {
        "background": [{ "color": { "solid": { "color": "#F5F7FA" } }, "transparency": 0 }]
      }
    },
    "lineChart": {
      "*": {
        "lineStyles": [{ "strokeWidth": 2.5 }],
        "categoryAxis": [{ "gridlineShow": false }],
        "valueAxis": [{ "gridlineColor": { "solid": { "color": "#E4E7EB" } } }]
      }
    },
    "card": {
      "*": {
        "labels": [{ "color": { "solid": { "color": "#1F4E79" } }, "fontSize": 28 }]
      }
    }
  }
}
